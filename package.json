{
  "name": "dsh-profiler",
  "version": "2.0.0",
  "description": "DeepSeek Harness 运行时剖析器：启动耗时归因、工具延迟采样（P95）、会话 token 归因、CoreProtect 式文件变更回档。Runtime profiler + rewind for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "profiler",
    "observability",
    "performance"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
